{
  "name": "one-of-one-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node --import tsx scripts/build-assets.ts",
    "icons:generate": "bash scripts/generate-icons.sh",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:browser": "node --import tsx scripts/test-browser.ts",
    "browser:check": "node --env-file-if-exists=.env --import tsx scripts/browser-smoke.ts",
    "secret-scan": "bash scripts/secret-scan.sh"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
